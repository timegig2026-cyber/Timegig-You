rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Allow any authenticated user to create a referral record under a tenant's referrals subcollection
      // provided referrerUid != newly registered user's uid (no self referral)
      match /referrals/{referralId} {
        allow read, list: if isOwner(userId);
        allow create: if isSignedIn() && request.resource.data.referredUid == request.auth.uid && request.auth.uid != userId;
        allow update, delete: if isOwner(userId);
      }
    }
  }
}
