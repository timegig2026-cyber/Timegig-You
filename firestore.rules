rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Allow authenticated referred users to record their referral under the referrer's subcollection
      // or the referrer themselves to manage their referrals
      match /referrals/{referralId} {
        allow read, list: if isOwner(userId);
        allow create, update: if isSignedIn() && (
          (request.resource.data.referredUid == request.auth.uid && request.auth.uid != userId) ||
          isOwner(userId)
        );
        allow delete: if isOwner(userId);
      }
    }
  }
}
